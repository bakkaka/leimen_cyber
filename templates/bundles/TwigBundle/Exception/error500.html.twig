{% extends 'base.html.twig' %}

{% block title %}Erreur technique - CyberLeimen | Revenez bientôt{% endblock %}

{% block meta_description %}
    <meta name="description" content="Une erreur technique temporaire s'est produite. Nos équipes travaillent à résoudre le problème. Merci de votre compréhension.">
{% endblock %}

{% block meta_robots %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-code mb-4">
                    <span class="display-1 fw-bold text-danger">500</span>
                </div>
                <div class="error-icon mb-4">
                    <i class="bi bi-server display-1 text-muted"></i>
                </div>
                <h1 class="mb-3">Erreur technique</h1>
                <p class="lead mb-4">
                    Une erreur temporaire s'est produite.
                </p>
                <div class="alert alert-warning">
                    <i class="bi bi-tools"></i>
                    Nos équipes techniques travaillent à résoudre le problème.
                </div>
                
                {# ✅ Informations de statut #}
                <div class="status-info mt-4">
                    <div class="row">
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-clock-history fs-2"></i>
                                <p class="mb-0 mt-2">Temps estimé<br><strong>Quelques minutes</strong></p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-envelope-paper fs-2"></i>
                                <p class="mb-0 mt-2">Soyez notifié<br><strong>À votre retour</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4">
                    <a href="{{ path('app_home') }}" class="btn btn-primary">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                    <button onclick="location.reload()" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-repeat"></i> Réessayer
                    </button>
                </div>
                
                {# ✅ Newsletter pour retenir l'utilisateur #}
                <div class="mt-5 p-3 bg-light rounded">
                    <p class="mb-2">🔔 Restez informé de nos actualités :</p>
                    <form action="{{ path('app_newsletter_subscribe') }}" method="post" class="d-flex justify-content-center flex-wrap gap-2">
                        <input type="email" name="email" class="form-control w-auto" placeholder="Votre email" required>
                        <button type="submit" class="btn btn-outline-primary">S'abonner</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}