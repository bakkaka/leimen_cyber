{% extends 'base.html.twig' %}

{% block title %}Accès restreint - CyberLeimen | Formations Cybersécurité{% endblock %}

{% block meta_description %}
    <meta name="description" content="Vous devez être connecté ou avoir accès à cette formation. Inscrivez-vous pour découvrir nos formations en cybersécurité.">
{% endblock %}

{% block meta_robots %}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-code mb-4">
                    <span class="display-1 fw-bold text-danger">403</span>
                </div>
                <div class="error-icon mb-4">
                    <i class="bi bi-shield-lock display-1 text-muted"></i>
                </div>
                <h1 class="mb-3">Accès restreint</h1>
                <p class="lead mb-4">
                    Vous n'avez pas les droits nécessaires pour accéder à cette page.
                </p>
                
                {% if not app.user %}
                    <div class="alert alert-warning">
                        <i class="bi bi-person-circle"></i>
                        Vous n'êtes pas connecté.
                    </div>
                    
                    {# ✅ Formulaire de connexion rapide #}
                    <div class="card mt-3 mb-3">
                        <div class="card-body">
                            <h5>Connectez-vous à votre compte</h5>
                            <a href="{{ path('app_login') }}" class="btn btn-primary mt-2">
                                <i class="bi bi-box-arrow-in-right"></i> Se connecter
                            </a>
                            <a href="{{ path('app_register') }}" class="btn btn-outline-secondary mt-2 ms-2">
                                <i class="bi bi-person-plus"></i> Créer un compte
                            </a>
                        </div>
                    </div>
                    
                    {# ✅ Call-to-action SEO #}
                    <div class="mt-3">
                        <p class="text-muted">
                            📚 Plus de 500+ étudiants nous font confiance au Maroc
                        </p>
                    </div>
                {% else %}
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Vous n'avez pas accès à cette formation.
                    </div>
                    
                    {# ✅ Proposition alternative #}
                    <div class="card mt-3 mb-3 bg-light">
                        <div class="card-body">
                            <h5>🎓 Découvrez nos formations accessibles</h5>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <a href="{{ path('app_course_index') }}" class="btn btn-outline-primary w-100 mb-2">
                                        <i class="bi bi-book"></i> Toutes nos formations
                                    </a>
                                </div>
                                <div class="col-md-6">
                                    <a href="https://wa.me/212643259637?text=Bonjour%2C%20je%20souhaite%20acc%C3%A9der%20%C3%A0%20une%20formation"
                                       class="btn btn-success w-100 mb-2">
                                        <i class="bi bi-whatsapp"></i> Contacter le support
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}