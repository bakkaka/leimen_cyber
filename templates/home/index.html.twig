{% extends 'base.html.twig' %}

{% block title %}Cyber Formation Maroc - Formation Cybersécurité{% endblock %}
{% block description %}Formation cybersécurité au Maroc. Cours pratiques en hacking éthique, protection des données et sécurité réseau. Certificat officiel offert.{% endblock %}
{% block og_title %}Cyber Formation Maroc - Formation Cybersécurité{% endblock %}
{% block og_description %}Formez-vous à la cybersécurité avec nos cours pratiques. Certificat officiel offert.{% endblock %}
{% block og_image %}{{ absolute_url(asset('images/cyber-og.png')) }}{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container">
        <h1 class="hero-title">Formez-vous à la cybersécurité</h1>
        <p class="hero-subtitle">Cours pratiques, certifications officielles, accès à vie.</p>
        <div class="hero-buttons">
            <a href="{{ path('app_course_index') }}" class="btn-cyber btn-lg me-3">
                📚 Voir nos formations
            </a>
            <a href="#" class="btn-cyber-outline btn-lg">
                🎬 Extraits gratuits
            </a>
        </div>
    </div>
</div>

<div class="container py-5">
    <h2 class="text-center mb-5">Nos formations les plus récentes</h2>
    <div class="row g-4">
        {% for course in courses %}
            <div class="col-md-6 col-lg-4">
                <div class="course-card">
                    <div class="course-image">
                        {% if course.imageUrl %}
                            <img src="{{ course.imageUrl }}" alt="{{ course.title }}" loading="lazy">
                        {% else %}
                            <i class="bi bi-shield-shaded"></i>
                        {% endif %}
                        <span class="course-badge badge-{{ course.level }}">
                            {{ course.level == 'beginner' ? 'Débutant' : (course.level == 'intermediate' ? 'Intermédiaire' : 'Avancé') }}
                        </span>
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{ course.title }}</h3>
                        <p class="course-description">
                            {{ course.shortDescription|default(course.description|striptags|slice(0, 100)) }}...
                        </p>
                        <div class="course-meta">
                            <span><i class="bi bi-clock"></i> {{ course.duration }} min</span>
                            <span><i class="bi bi-play-circle"></i> {{ course.modules|length }} modules</span>
                        </div>
                        {#<div class="course-price">
                            {{ (course.price / 100)|number_format(0, ',', ' ') }} MAD
                        </div>#}
                        <a href="{{ path('app_course_show', {'slug': course.slug}) }}" class="btn-cyber w-100">
                            📖 Voir la formation
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">
                    Aucune formation disponible pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}