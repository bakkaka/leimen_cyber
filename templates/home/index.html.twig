{% extends 'base.html.twig' %}

{% block title %}Cyber Formation Maroc - Formation Cybersécurité{% endblock %}

{% block body %}
<div class="hero-section bg-dark text-white text-center py-5">
    <div class="container">
        <h1 class="display-4">Formez-vous à la cybersécurité</h1>
        <p class="lead">Cours pratiques, certifications officielles, accès à vie.</p>
        <div class="mt-4">
            <a href="{{ path('app_course_index') }}" class="btn btn-primary btn-lg me-3">📚 Voir nos formations</a>
            <a href="#" class="btn btn-outline-light btn-lg">🎬 Extraits gratuits</a>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Nos formations les plus récentes</h2>
    <div class="row">
        {% for course in courses %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">{{ course.title }}</h5>
                        <p class="card-text">{{ course.shortDescription|default(course.description|slice(0, 100)) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                {{ course.level == 'beginner' ? 'Débutant' : (course.level == 'intermediate' ? 'Intermédiaire' : 'Avancé') }}
                            </span>
                            <span class="text-primary fw-bold">{{ (course.price / 100)|number_format(0, ',', ' ') }} DH</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a href="{{ path('app_course_show', {'slug': course.slug}) }}" class="btn btn-outline-primary w-100">Voir la formation</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">Aucune formation pour le moment.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}