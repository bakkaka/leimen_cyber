<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Inscription Formation</title>
</head>

<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,sans-serif;">

<div style="max-width:600px;margin:40px auto;background:white;border-radius:10px;padding:40px;">

    <h1 style="color:#0d6efd;margin-bottom:20px;">
        Bonjour {{ user.fullName ?: user.email }}
    </h1>

    <p style="font-size:16px;color:#333;">
        Votre inscription à la formation suivante a été validée :
    </p>

    <h2 style="color:#198754;">
        {{ course.title }}
    </h2>

    <p style="font-size:16px;color:#333;line-height:1.6;">
        Vous pouvez commencer votre apprentissage dès maintenant.
    </p>

    <div style="margin-top:30px;">
        <a href="http://127.0.0.1:8000/courses"
           style="background:#0d6efd;
                  color:white;
                  padding:15px 25px;
                  text-decoration:none;
                  border-radius:5px;
                  display:inline-block;">
            Accéder aux formations
        </a>
    </div>

</div>

</body>
</html>