{% extends 'base.html.twig' %}

{% block title %}Formations Cybersécurité - Cours pratiques au Maroc{% endblock %}
{% block description %}Découvrez nos formations en cybersécurité au Maroc. Débutant, intermédiaire ou avancé. Certificat officiel offert.{% endblock %}
{% block og_title %}Formations Cybersécurité - Cyber Formation Maroc{% endblock %}
{% block og_description %}Formez-vous à la cybersécurité. Cours pratiques, vidéos HD, certificat officiel. Inscription en ligne.{% endblock %}
{% block og_image %}{{ absolute_url(asset('images/cyber-og.png')) }}{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container text-center">
        <div class="hero-badge">🔥 Formations certifiantes 🔥</div>
        <h1 class="hero-title">Maîtrisez la Cybersécurité</h1>
        <p class="hero-subtitle">+50 étudiants formés · Certificat offert · Support 24/7</p>
        <div class="hero-buttons">
            <a href="#formations" class="btn-cyber btn-lg">📚 Voir les formations</a>
            <a href="#extraits" class="btn-cyber-outline btn-lg">▶️ Extraits gratuits</a>
        </div>
    </div>
</div>

{# ========================================== #}
{# VIDÉO DE PRÉSENTATION #}
{# ========================================== #}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="ratio ratio-16x9 shadow rounded-4 overflow-hidden">
                <iframe 
                    src="https://www.youtube.com/embed/TA_VIDEO_ID" 
                    title="Présentation complète de la formation" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen>
                </iframe>
            </div>
            <div class="text-center mt-4">
                <a href="#formations" class="btn btn-outline-primary btn-lg btn-bounce">
                    👇 Découvrez les formations 👇
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5" id="formations">
    <h2 class="text-center mb-5">📚 Nos formations</h2>
    
    {% set levels = [
        {'name': 'beginner', 'label': 'Débutant', 'icon': 'star-fill', 'color': 'success', 'courses': beginnerCourses},
        {'name': 'intermediate', 'label': 'Intermédiaire', 'icon': 'star-half', 'color': 'warning', 'courses': intermediateCourses},
        {'name': 'advanced', 'label': 'Avancé', 'icon': 'gem', 'color': 'danger', 'courses': advancedCourses}
    ] %}
    
    {% for level in levels %}
        {% if level.courses|length > 0 %}
        <div class="mb-5">
            <h3 class="mb-4">
                <i class="bi bi-{{ level.icon }} text-{{ level.color }} me-2"></i>
                Niveau {{ level.label }}
                <span class="badge bg-{{ level.color }} ms-2">{{ level.courses|length }} formations</span>
            </h3>
            <div class="row g-4">
                {% for course in level.courses %}
                <div class="col-md-6 col-lg-4">
                    <div class="course-card">
                        <div class="course-image">
                            {% if course.imageUrl %}
                                <img src="{{ course.imageUrl }}" alt="{{ course.title }}" loading="lazy">
                            {% else %}
                                <i class="bi bi-shield-shaded"></i>
                            {% endif %}
                            <span class="course-badge badge-{{ level.name }}">{{ level.label }}</span>
                        </div>
                        <div class="course-content">
                            <h4 class="course-title">{{ course.title }}</h4>
                            <p class="course-description">
                                {{ course.shortDescription|default(course.description|striptags|slice(0, 100)) }}...
                            </p>
                            <div class="course-meta">
                                <span><i class="bi bi-clock"></i> {{ course.duration }} min</span>
                                <span><i class="bi bi-play-circle"></i> {{ course.modules|length }} modules</span>
                            </div>
                            {# PRIX SUPPRIMÉ – on discute du prix sur WhatsApp #}
                            <a href="{{ path('app_course_show', {'slug': course.slug}) }}" class="btn-cyber w-100">
                                📖 Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    {% endfor %}
</div>

<div id="extraits" class="bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-5">🎬 Extraits gratuits</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="video-placeholder" data-video-id="dQw4w9WgXcQ" data-platform="youtube" data-video-title="Pourquoi vos mots de passe sont faibles ?">
                    <img src="https://img.youtube.com/vi/dQw4w9WgXcQ/hqdefault.jpg" alt="Miniature vidéo" class="w-100">
                    <div class="video-play-btn"><i class="bi bi-play-fill"></i></div>
                    <div class="p-3 bg-white">
                        <h5>Pourquoi vos mots de passe sont faibles ?</h5>
                        <p class="text-muted small">Extrait de 12 min</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="video-placeholder" data-video-id="dQw4w9WgXcQ" data-platform="youtube" data-video-title="Le phishing expliqué">
                    <img src="https://img.youtube.com/vi/dQw4w9WgXcQ/hqdefault.jpg" alt="Miniature vidéo" class="w-100">
                    <div class="video-play-btn"><i class="bi bi-play-fill"></i></div>
                    <div class="p-3 bg-white">
                        <h5>Le phishing expliqué simplement</h5>
                        <p class="text-muted small">Extrait de 15 min</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}
.btn-bounce {
    animation: bounce 1.2s infinite ease-in-out;
}
</style>
{% endblock %}