{% extends 'base.html.twig' %}

{% block title %}{{ course.title }} - Cyber Formation Maroc{% endblock %}
{% block description %}{{ course.shortDescription|default(course.description|striptags|slice(0, 160)) }}{% endblock %}
{% block og_title %}{{ course.title }} - Cyber Formation Maroc{% endblock %}
{% block og_description %}{{ course.shortDescription|default(course.description|striptags|slice(0, 160)) }}{% endblock %}
{% block og_url %}{{ app.request.uri }}{% endblock %}
{% block og_image %}{% if course.imageUrl %}{{ absolute_url(course.imageUrl) }}{% else %}{{ absolute_url(asset('images/cyber-og.png')) }}{% endif %}{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container">
        <h1 class="hero-title text-center">{{ course.title }}</h1>
        
        {% if course.imageUrl %}
        <div class="text-center my-4">
            <img src="{{ course.imageUrl }}" alt="{{ course.title }}" class="img-fluid rounded-4 shadow" style="max-height: 400px; object-fit: cover;">
        </div>
        {% endif %}
        
        <div class="row align-items-center mt-5">
            <div class="col-lg-8">
                <p class="lead">{{ course.shortDescription|default(course.description|striptags|slice(0, 200)) }}</p>
                <div class="d-flex gap-3 mt-4">
                    <div><i class="bi bi-clock-history"></i> {{ course.duration }} min</div>
                    <div><i class="bi bi-folder"></i> {{ course.modules|length }} modules</div>
                    <div><i class="bi bi-play-circle"></i> {{ course.modules|reduce((total, module) => total + module.lessons|length, 0) }} leçons</div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4 text-center">
                        
                        {# ========================================== #}
                        {# ⭐ VÉRIFICATION DE L'ACCÈS #}
                        {# ========================================== #}
                        
                        {% set hasValidAccess = false %}
                        {% set enrollmentId = null %}
                        
                        {% if app.user %}
                            {% for enrollment in app.user.enrollments %}
                                {% if enrollment.course.id == course.id %}
                                    {% if enrollment.paymentMethod == 'bank_transfer_validated' %}
                                        {% set hasValidAccess = true %}
                                        {% set enrollmentId = enrollment.id %}
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        
                        {# ========================================== #}
                        {# AFFICHAGE SELON LE STATUT #}
                        {# ========================================== #}
                        
                        {% if not app.user %}
                            {# Non connecté #}
                            <a href="https://wa.me/212643259637?text=Bonjour%2C%20je%20suis%20int%C3%A9ress%C3%A9%20par%20la%20formation%20{{ course.title|url_encode }}"
                               class="btn btn-success w-100 py-2" style="background-color: #25D366; border: none; border-radius: 50px; font-weight: bold; color: white;">
                                <i class="bi bi-whatsapp me-2"></i>💬 Me contacter sur WhatsApp
                            </a>
                            <small class="text-muted d-block mt-2">📱 Réponse rapide · Prix adapté</small>
                            
                        {% elseif hasValidAccess %}
                            {# ✅ ACCÈS VALIDÉ PAR L'ADMIN → BOUTON VERT #}
                            
                            {# Calcul de la progression - Utilisation de lessonProgresses #}
                            {% set completedLessonsCount = 0 %}
                            {% set totalLessons = 0 %}
                            
                            {% for module in course.modules %}
                                {% set totalLessons = totalLessons + module.lessons|length %}
                                {% for lesson in module.lessons %}
                                    {% for progress in app.user.lessonProgresses %}
                                        {% if progress.lesson.id == lesson.id and progress.completed %}
                                            {% set completedLessonsCount = completedLessonsCount + 1 %}
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            {% endfor %}
                            
                            {% set progressPercent = totalLessons > 0 ? (completedLessonsCount / totalLessons * 100)|round : 0 %}
                            
                            {% if progressPercent >= 100 %}
                                <div class="alert alert-success">
                                    🎉 Félicitations ! Vous avez terminé cette formation.
                                </div>
                                <a href="{{ path('generate_certificate') }}?enrollment_id={{ enrollmentId }}" class="btn btn-success w-100 py-2" style="background-color: #28a745; border: none; border-radius: 50px; font-weight: bold;">
    🏆 Télécharger mon certificat
</a>
                            {% else %}
                                <a href="{{ path('app_course_learn', {slug: course.slug}) }}" class="btn btn-success w-100 py-2" style="background-color: #28a745; border: none; border-radius: 50px; font-weight: bold; font-size: 1.1rem;">
                                    🚀 Accéder au cours
                                </a>
                                <div class="progress mt-2">
                                    <div class="progress-bar bg-success" style="width: {{ progressPercent }}%"></div>
                                </div>
                                <small class="text-muted">{{ progressPercent }}% complété</small>
                            {% endif %}
                            
                        {% else %}
                            {# ❌ PAS D'ACCÈS ENCORE → WhatsApp pour demander #}
                            <div class="alert alert-info">
                                💡 Vous n'avez pas encore accès à cette formation.
                            </div>
                            <a href="https://wa.me/212643259637?text=Bonjour%2C%20je%20suis%20connect%C3%A9%20(email%20:{{ app.user.email|url_encode }})%20et%20je%20souhaite%20obtenir%20l%27acc%C3%A8s%20%C3%A0%20{{ course.title|url_encode }}"
                               class="btn btn-success w-100 py-2" style="background-color: #25D366; border: none; border-radius: 50px; font-weight: bold; color: white;">
                                <i class="bi bi-whatsapp me-2"></i>💰 Demander l'accès (WhatsApp)
                            </a>
                            <small class="text-muted d-block mt-2">Contactez l'administrateur pour obtenir l'accès.</small>
                        {% endif %}
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h2>Description</h2>
                    {{ course.description|raw }}
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2>Programme de la formation</h2>
                    {% for module in course.modules %}
                        <div class="border rounded-3 mb-3">
                            <div class="p-3 bg-light">
                                <strong>Module {{ module.orderNumber }} : {{ module.title }}</strong>
                                <br><small>{{ module.lessons|length }} leçons</small>
                            </div>
                            <div class="p-3">
                                {% for lesson in module.lessons %}
                                    <div class="d-flex justify-content-between mb-2">
                                        <div><i class="bi bi-play-circle me-2"></i> {{ lesson.title }}</div>
                                        <small>{{ lesson.duration }} min</small>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
