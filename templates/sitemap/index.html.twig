{% extends 'base.html.twig' %}

{% block title %}Plan du site - Cyber Formation Maroc{% endblock %}
{% block description %}Plan du site complet de Cyber Formation Maroc : accueil, formations, contact.{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center mb-5">📍 Plan du site</h1>

    <div class="row">
        <div class="col-md-4 mb-4">
            <h3 class="h5 text-primary">Pages principales</h3>
            <ul class="list-unstyled">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_course_index') }}">Toutes les formations</a></li>
                <li><a href="{{ path('app_contact') }}">Contact</a></li>
            </ul>
        </div>

        <div class="col-md-8 mb-4">
            <h3 class="h5 text-primary">Nos formations</h3>
            <div class="row">
                {% for course in courses %}
                    <div class="col-md-6">
                        <a href="{{ path('app_course_show', {'slug': course.slug}) }}">
                            {{ course.title }}
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_sitemap_xml') }}" class="btn-cyber-outline">
            📄 Voir le sitemap XML
        </a>
    </div>
</div>
{% endblock %}