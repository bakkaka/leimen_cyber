{% extends 'base.html.twig' %}

{% block title %}Inscription - Cyber Formation Maroc{% endblock %}

{% block body %}

<div class="container py-5">

<div class="row justify-content-center">

    <div class="col-lg-7 col-xl-6">

        <div class="card shadow-lg border-0 rounded-4 card-register">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4" data-aos="fade-up">

                    <i class="bi bi-person-plus-fill display-2"
                       style="color:#FF7F00;"></i>

                    <h1 class="h2 fw-bold mt-3">
                        Créez votre compte
                    </h1>

                    <p class="text-muted">
                        Rejoignez Cyber Formation Maroc et obtenez votre certificat de formation.
                    </p>

                </div>

                {{ form_start(registrationForm) }}

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Email <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>

                        {{ form_widget(registrationForm.email,{
                            attr:{
                                class:'form-control',
                                placeholder:'votre@email.com'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.email) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Nom complet <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>

                        {{ form_widget(registrationForm.fullName,{
                            attr:{
                                class:'form-control',
                                placeholder:'Nom et prénom'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.fullName) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Téléphone <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-phone"></i>
                        </span>

                        {{ form_widget(registrationForm.phone,{
                            attr:{
                                class:'form-control',
                                placeholder:'+212 6XX XXX XXX'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.phone) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Âge <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-calendar"></i>
                        </span>

                        {{ form_widget(registrationForm.age,{
                            attr:{
                                class:'form-control',
                                placeholder:'Ex : 25'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.age) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Ville <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        {{ form_widget(registrationForm.city,{
                            attr:{
                                class:'form-control',
                                placeholder:'Casablanca'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.city) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Mot de passe <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        {{ form_widget(registrationForm.plainPassword,{
                            attr:{
                                class:'form-control password-main',
                                placeholder:'Choisissez un mot de passe'
                            }
                        }) }}

                        <button
                            type="button"
                            class="btn btn-outline-secondary toggle-password"
                            data-target="main">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <div class="password-strength mt-2">

                        <div class="progress" style="height:8px">

                            <div
                                id="passwordStrengthBar"
                                class="progress-bar"
                                style="width:0%">
                            </div>

                        </div>

                        <small id="passwordStrengthText"></small>

                    </div>

                    {{ form_errors(registrationForm.plainPassword) }}

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Confirmation du mot de passe
                        <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-shield-lock"></i>
                        </span>

                        {{ form_widget(registrationForm.confirmPassword,{
                            attr:{
                                class:'form-control password-confirm',
                                placeholder:'Confirmez votre mot de passe'
                            }
                        }) }}

                        <button
                            type="button"
                            class="btn btn-outline-secondary toggle-password"
                            data-target="confirm">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <small id="passwordMatchMessage"></small>

                    {{ form_errors(registrationForm.confirmPassword) }}

                </div>

                <div class="form-check mb-4">

                    {{ form_widget(registrationForm.agreeTerms,{
                        attr:{
                            class:'form-check-input'
                        }
                    }) }}

                    {{ form_label(
                        registrationForm.agreeTerms,
                        'J’accepte les conditions d’utilisation',
                        {
                            label_attr:{
                                class:'form-check-label'
                            }
                        }
                    ) }}

                    {{ form_errors(registrationForm.agreeTerms) }}

                </div>

                <button
    type="submit"
    class="btn-cyber w-100 py-3">

    <i class="bi bi-check-circle me-2"></i>
    S'inscrire

</button>

{{ form_end(registrationForm) }}

{#<input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

{{ form_end(registrationForm,{render_rest:false}) }}#}

                <hr class="my-4">

                <div class="text-center">

                    <p class="mb-2">
                        Déjà inscrit ?
                    </p>

                    <a href="{{ path('app_login') }}"
                       class="btn-cyber-outline w-100 py-2">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Se connecter

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
```

</div>
{% endblock %}
