{% extends 'base.html.twig' %}

{% block title %}Détails : {{ user.email }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm rounded-4 mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">{{ user.email }}</h2>
            <div>
                <a href="{{ path('app_admin_users') }}" class="btn btn-light btn-sm">← Retour à la liste</a>
            </div>
        </div>
        <div class="card-body">
            <p><strong>Nom :</strong> {{ user.fullName|default('Non renseigné') }}</p>
            <p><strong>Âge :</strong> {{ user.age|default('Non renseigné') }}</p>
            <p><strong>Ville :</strong> {{ user.city|default('Non renseigné') }}</p>
            <p><strong>Téléphone :</strong> {{ user.phone|default('Non renseigné') }}</p>
            <p><strong>Inscrit le :</strong> {{ user.createdAt|date('d/m/Y H:i') }}</p>
            <p><strong>Rôles :</strong> {{ user.roles|join(', ') }}</p>
            <p><strong>Statut :</strong>
                {% if user.isActive %}
                    <span class="badge bg-success">Actif</span>
                {% else %}
                    <span class="badge bg-danger">Désactivé</span>
                {% endif %}
            </p>
            <p><strong>Email vérifié :</strong> {{ user.isVerified ? '✅ Oui' : '❌ Non' }}</p>
        </div>
    </div>

    <div class="mb-3">
        <h3>📚 Formations et accès</h3>
        <p class="text-muted">Cliquez sur <strong>🔓 Donner l'accès</strong> pour autoriser l'utilisateur à suivre une formation. Le bouton se transforme automatiquement en <strong>🔒 Retirer l'accès</strong> une fois validé.</p>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Cours</th>
                    <th>Statut</th>
                    <th>Progression</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {# Affichage des cours déjà inscrits #}
                {% for enrollment in enrollments %}
                    <tr>
                        <td>{{ enrollment.course.title }}</td>
                        <td>
                            {% if enrollment.paymentMethod == 'bank_transfer_validated' %}
                                <span class="badge bg-success">✅ Accès autorisé</span>
                            {% else %}
                                <span class="badge bg-warning">⏳ En attente</span>
                            {% endif %}
                        </td>
                        <td>{{ enrollment.progress }}%{% if enrollment.progress >= 100 %} 🎓{% endif %}</td>
                        <td>
                            {% if enrollment.paymentMethod == 'bank_transfer_validated' %}
                                <form method="post" action="{{ path('app_admin_enrollment_remove_access', {userId: user.id, courseId: enrollment.course.id}) }}" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove-single-' ~ user.id ~ '-' ~ enrollment.course.id) }}">
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('🔒 Retirer l\'accès pour {{ enrollment.course.title }} ?')">
                                        🔒 Retirer l'accès
                                    </button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('app_admin_enrollment_give_access', {userId: user.id, courseId: enrollment.course.id}) }}" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('give-single-' ~ user.id ~ '-' ~ enrollment.course.id) }}">
                                    <button class="btn btn-sm btn-success" onclick="return confirm('✅ Donner l\'accès pour {{ enrollment.course.title }} ?')">
                                        🔓 Donner l'accès
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                
                {# Affichage des cours auxquels l'utilisateur n'est PAS encore inscrit #}
                {% set enrolledCourseIds = enrollments|map(e => e.course.id) %}
                {% for course in courses %}
                    {% if course.id not in enrolledCourseIds %}
                        <tr>
                            <td>{{ course.title }}</td>
                            <td><span class="badge bg-secondary">❌ Non inscrit</span></td>
                            <td>0%</td>
                            <td>
                                <form method="post" action="{{ path('app_admin_enrollment_give_access', {userId: user.id, courseId: course.id}) }}" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('give-single-' ~ user.id ~ '-' ~ course.id) }}">
                                    <button class="btn btn-sm btn-success" onclick="return confirm('✅ Créer une inscription et donner l\'accès pour {{ course.title }} ?')">
                                        🔓 Créer + Donner accès
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h3>📊 Progression par module</h3>
    {% if moduleProgress|length > 0 %}
        <ul>
            {% for progress in moduleProgress %}
                <li>
                    <strong>{{ progress.module.title }}</strong> :
                    {% if progress.completed %}
                        ✅ Terminé le {{ progress.completedAt|date('d/m/Y') }}
                        (Quiz: {{ progress.quizScore }}%)
                    {% else %}
                        ⏳ Non terminé
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune progression enregistrée.</p>
    {% endif %}

    <h3>📝 Tentatives de quiz</h3>
    {% if quizAttempts|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Quiz</th>
                        <th>Date</th>
                        <th>Score</th>
                        <th>Réussi</th>
                    </tr>
                </thead>
                <tbody>
                    {% for attempt in quizAttempts %}
                        <tr>
                            <td>{{ attempt.quiz.title }}</td>
                            <td>{{ attempt.attemptedAt|date('d/m/Y H:i') }}</td>
                            <td>{{ attempt.score }}%</td>
                            <td>{{ attempt.passed ? '✅ Oui' : '❌ Non' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>Aucune tentative de quiz.</p>
    {% endif %}
</div>
{% endblock %}