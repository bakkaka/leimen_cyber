{% extends 'base.html.twig' %}

{% block title %}Gestion des formations{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Gestion des formations</h1>
    <a href="{{ path('app_admin_course_new') }}" class="btn btn-primary mb-3">+ Nouvelle formation</a>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Niveau</th>
                    <th>Prix</th>
                    <th>Publié</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for course in courses %}
                    <tr>
                        <td>{{ course.id }}</td>
                        <td>{{ course.title }}</td>
                        <td>{{ course.level }}</td>
                        <td>{{ (course.price / 100)|number_format(0, ',', ' ') }} DH</td>
                        <td>{{ course.isPublished ? '✅ Oui' : '❌ Non' }}</td>
                        <td>
                            <a href="{{ path('app_admin_course_edit', {id: course.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            <form method="post" action="{{ path('app_admin_course_delete', {id: course.id}) }}" style="display:inline-block">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                                <button class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette formation ?')">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucune formation trouvée. Cliquez sur "+ Nouvelle formation" pour en créer une.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}